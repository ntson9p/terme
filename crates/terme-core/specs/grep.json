{
  "names": ["grep"],
  "description": "search text for a pattern",
  "options": [
    { "names": ["-i", "--ignore-case"], "description": "ignore case", "priority": 90 },
    { "names": ["-r", "--recursive"], "description": "search folders", "priority": 89 },
    { "names": ["-n", "--line-number"], "description": "show line numbers", "priority": 85 },
    { "names": ["-v", "--invert-match"], "description": "lines that don't match", "priority": 84 },
    { "names": ["-l", "--files-with-matches"], "description": "file names only", "priority": 80 },
    { "names": ["-w", "--word-regexp"], "description": "whole words only", "priority": 75 },
    { "names": ["-E", "--extended-regexp"], "description": "extended regex", "priority": 74 },
    { "names": ["-F", "--fixed-strings"], "description": "plain text, not a pattern", "priority": 73 },
    { "names": ["-c", "--count"], "description": "count matches", "priority": 70 },
    { "names": ["-o", "--only-matching"], "description": "only the matching part", "priority": 65 },
    { "names": ["-A", "--after-context"], "description": "lines after each match",
      "arg": { "name": "NUM", "description": "number of lines" } },
    { "names": ["-B", "--before-context"], "description": "lines before each match",
      "arg": { "name": "NUM", "description": "number of lines" } },
    { "names": ["-C", "--context"], "description": "lines around each match",
      "arg": { "name": "NUM", "description": "number of lines" } },
    { "names": ["-e", "--regexp"], "description": "pattern (can repeat)", "repeatable": true,
      "arg": { "name": "PATTERN", "description": "pattern to search for" } },
    { "names": ["-f", "--file"], "description": "patterns from a file",
      "arg": { "name": "FILE", "template": "filepaths" } },
    { "names": ["-x", "--line-regexp"], "description": "whole lines only" },
    { "names": ["-L", "--files-without-match"], "description": "files with no match" },
    { "names": ["-R", "--dereference-recursive"], "description": "search folders, follow links" },
    { "names": ["-P", "--perl-regexp"], "description": "Perl regex" },
    { "names": ["-h", "--no-filename"], "description": "hide file names" },
    { "names": ["-H", "--with-filename"], "description": "show file names" },
    { "names": ["-q", "--quiet"], "description": "no output, just the exit status" },
    { "names": ["-s", "--no-messages"], "description": "hide file errors" },
    { "names": ["-m", "--max-count"], "description": "stop after N matches",
      "arg": { "name": "NUM", "description": "number of matches" } },
    { "names": ["--include"], "description": "only files matching a glob", "requires_equals": true,
      "arg": { "name": "GLOB", "description": "e.g. *.py" } },
    { "names": ["--exclude"], "description": "skip files matching a glob", "requires_equals": true,
      "arg": { "name": "GLOB", "description": "e.g. *.min.js" } },
    { "names": ["--exclude-dir"], "description": "skip folders matching a glob", "requires_equals": true,
      "arg": { "name": "GLOB", "description": "e.g. node_modules" } },
    { "names": ["--color"], "description": "highlight matches", "requires_equals": true,
      "arg": { "name": "WHEN", "suggestions": [ { "name": "auto" }, { "name": "always" }, { "name": "never" } ] } }
  ],
  "args": [
    { "name": "PATTERN", "description": "what to search for" },
    { "name": "FILE", "optional": true, "variadic": true, "template": "filepaths" }
  ]
}
