{
  "names": ["systemctl"],
  "description": "control systemd services",
  "options": [
    { "names": ["--user"], "description": "your own services", "priority": 50 },
    { "names": ["--now"], "description": "also start or stop it now", "priority": 45 },
    { "names": ["-a", "--all"], "description": "include inactive units" },
    { "names": ["-t", "--type"], "description": "only this unit type", "requires_equals": true,
      "arg": { "name": "type", "suggestions": [
        { "name": "service" }, { "name": "timer" }, { "name": "socket" }, { "name": "mount" }, { "name": "target" } ] } },
    { "names": ["--state"], "description": "only units in this state", "requires_equals": true,
      "arg": { "name": "state", "suggestions": [
        { "name": "running" }, { "name": "failed" }, { "name": "active" }, { "name": "inactive" } ] } },
    { "names": ["--failed"], "description": "failed units only" },
    { "names": ["-q", "--quiet"], "description": "less output" },
    { "names": ["-l", "--full"], "description": "don't cut long lines" },
    { "names": ["--no-pager"], "description": "don't page the output" },
    { "names": ["-f", "--force"], "description": "overwrite conflicting links" }
  ],
  "subcommands": [
    { "names": ["status"], "description": "show a unit's state and logs", "priority": 100,
      "args": [ { "name": "unit", "optional": true, "variadic": true,
        "generator": { "script": ["systemctl", "list-units", "--all", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["start"], "description": "start units", "priority": 99,
      "args": [ { "name": "unit", "variadic": true,
        "generator": { "script": ["systemctl", "list-unit-files", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["stop"], "description": "stop units", "priority": 98,
      "args": [ { "name": "unit", "variadic": true,
        "generator": { "script": ["systemctl", "list-units", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["restart"], "description": "restart units", "priority": 97,
      "args": [ { "name": "unit", "variadic": true,
        "generator": { "script": ["systemctl", "list-units", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["reload"], "description": "reload units' config", "priority": 90,
      "args": [ { "name": "unit", "variadic": true,
        "generator": { "script": ["systemctl", "list-units", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["enable"], "description": "start units at boot", "priority": 96,
      "args": [ { "name": "unit", "variadic": true,
        "generator": { "script": ["systemctl", "list-unit-files", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["disable"], "description": "don't start units at boot", "priority": 95,
      "args": [ { "name": "unit", "variadic": true,
        "generator": { "script": ["systemctl", "list-unit-files", "--plain", "--no-legend", "--no-pager"], "kind": "unit", "field": 0 } } ] },
    { "names": ["is-active"], "description": "check whether units run" },
    { "names": ["is-enabled"], "description": "check whether units start at boot" },
    { "names": ["list-units"], "description": "list loaded units", "priority": 80 },
    { "names": ["list-unit-files"], "description": "list installed unit files" },
    { "names": ["list-timers"], "description": "list timers" },
    { "names": ["daemon-reload"], "description": "reload unit files", "priority": 85 },
    { "names": ["cat"], "description": "show a unit's files" },
    { "names": ["edit"], "description": "edit a unit with an override" },
    { "names": ["show"], "description": "show a unit's properties" },
    { "names": ["mask"], "description": "make units impossible to start" },
    { "names": ["unmask"], "description": "undo mask" },
    { "names": ["kill"], "description": "send a signal to a unit's processes" },
    { "names": ["reset-failed"], "description": "clear failed states" },
    { "names": ["reboot"], "description": "restart the machine" },
    { "names": ["poweroff"], "description": "shut the machine down" },
    { "names": ["suspend"], "description": "suspend the machine" }
  ]
}
